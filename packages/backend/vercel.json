{
  "version": 2,
  "installCommand": "npm install --install-strategy=nested",
  "buildCommand": "npm run build -w packages/frontend && npx prisma generate && npm run build",
  "functions": {
    "api/index.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "api/index.ts" }]
}
